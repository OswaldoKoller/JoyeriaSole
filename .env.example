# =====================================================================
# Joyería Sole — Variables de entorno
# Copiar a `.env` (raíz del repo) y completar. `.env` NUNCA se sube a Git.
# En producción estas variables se configuran en el panel del hosting.
# =====================================================================

# --- Entorno ----------------------------------------------------------
# development | test | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug

# --- Base de datos (PostgreSQL en Docker, ver docker-compose.yml) -----
POSTGRES_USER=joyeria
POSTGRES_PASSWORD=cambiar_esta_clave_local
POSTGRES_DB=joyeria_dev
# Puerto del host para el contenedor de desarrollo (5432/5433 suelen estar ocupados)
POSTGRES_PORT=5434

DATABASE_URL=postgresql://joyeria:cambiar_esta_clave_local@localhost:5434/joyeria_dev?schema=public
# Base separada para pruebas de integración (se crea automáticamente en Docker)
TEST_DATABASE_URL=postgresql://joyeria:cambiar_esta_clave_local@localhost:5434/joyeria_test?schema=public

# --- API --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# Orígenes permitidos por CORS, separados por coma.
# En desarrollo el frontend usa el proxy de Vite (mismo origen), así que CORS casi no interviene.
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend (enlaces en correos futuros, redirecciones)
FRONTEND_URL=http://localhost:5173

# --- Autenticación ----------------------------------------------------
# Secreto para firmar cookies. Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio_de_al_menos_32_chars
# Duración de la sesión en horas
SESSION_TTL_HOURS=8

# --- Seed: usuario administrador inicial ------------------------------
# Solo lo usa `npm run db:seed`. Cambiar la contraseña tras el primer ingreso.
SEED_ADMIN_EMAIL=admin@joyeriasole.local
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=cambiar_esta_clave_admin_123

# --- Datos de demostración / E2E (npm run db:seed:demo) ----------------
# Contraseña de los 3 usuarios DEMO (uno por rol). Solo desarrollo local; mínimo 10 caracteres.
DEMO_USER_PASSWORD=cambiar_clave_demo_local

# Proxies/balanceadores PROPIOS delante de la API cuyo X-Forwarded-For se acepta (0 = ninguno).
# En Render/Railway suele ser 1 (verificar en los logs que request.ip sea la IP real del cliente).
# Con un valor mayor que el real, un atacante podría falsear su IP y evadir el límite de login.
# TRUST_PROXY_HOPS=0

# Intentos de login por IP cada 15 min (por defecto 10). No subir en producción; solo el E2E lo eleva.
# LOGIN_RATE_LIMIT_MAX=10
